{
  "permissions": {
    "allow": [
      "Bash(pnpm audit *)",
      "Bash(npm view *)",
      "Bash(git fetch *)",
      "Bash(pnpm lint*)",
      "Bash(pnpm build)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(gh pr view*)",
      "Bash(gh issue view*)",
      "Bash(git push*)",
      "Bash(gh pr create*)"
    ],
    "ask": [
      "Bash(pnpm db:seed*)",
      "Bash(pnpm storage:upload*)",
      "Bash(pnpm add*)",
      "Bash(pnpm remove*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-reminder.sh\""
          }
        ]
      }
    ]
  }
}
