DATABASE_URL=  # PostgreSQL connection string, e.g. postgresql://...
# ↑ ローカル dev/test や scripts/*.ts（seed 等）で使用。
#   本番（Cloudflare Workers）の実行時は Hyperdrive バインディング（wrangler.jsonc）経由で
#   接続するため DATABASE_URL は不要。

# Cloudflare Hyperdrive のローカルエミュレーション用 Postgres 接続文字列。
# pnpm dev / preview / deploy のビルド時に必要（preview はローカル DB、
# deploy のビルドは本番 DB=Neon を指す）。通常は DATABASE_URL と同値でよい。
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Storage. S3 (-compatible) is assumed.
# ↓ 本番（Cloudflare）では実行時シークレットとして `wrangler secret put` か
#   ダッシュボードで設定する（.env はローカル用）。
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT_URL=

# URL for PUBLIC access (view images) to the storage.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=

# Public site URL. Used as metadataBase for absolute OG/canonical URLs.
# NEXT_PUBLIC_* はビルド時にインライン化されるため、Cloudflare 用ビルドを行う
# 環境（CI / ローカル）に必ず設定すること。
NEXT_PUBLIC_SITE_URL=https://blog.akimasanishida.com

# Authentication
AUTH_SECRET=