# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright（E2E の成果物・認証 storageState）
/test-results
/playwright-report
/playwright/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local

# Claude Code (個人ローカル上書きのみ無視。settings.json / hooks / commands は共有)
.claude/settings.local.json

# generated docs site (docs/*.md が正本。HTML は pnpm docs:build で生成)
docs/_site/

# cloudflare / opennext
.open-next/
.wrangler/
.dev.vars*
# wrangler の生成型（実行時型を含み巨大）。pnpm cf-typegen で再生成する。
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts
